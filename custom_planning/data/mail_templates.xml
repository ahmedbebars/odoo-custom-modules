<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- إشعار نشر الشيفت -->
        <record id="email_template_shift_published" model="mail.template">
            <field name="name">Planning: إشعار نشر الشيفت</field>
            <field name="model_id" ref="model_planning_shift"/>
            <field name="subject">📅 تم تحديد شيفتك: {{ object.start_datetime | date('dd/MM/yyyy HH:mm') }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; direction: rtl; padding: 20px;">
    <h2 style="color: #875A7B;">📅 جدول العمل الجديد</h2>
    <p>مرحباً <strong>{{ object.resource_id.name }}</strong>،</p>
    <p>تم تحديد شيفت جديد لك:</p>
    <table style="border-collapse: collapse; width: 100%;">
        <tr style="background: #f5f5f5;">
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>الدور</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.role_id.name or 'غير محدد' }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>البداية</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.start_datetime | date('dd/MM/yyyy HH:mm') }}</td>
        </tr>
        <tr style="background: #f5f5f5;">
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>النهاية</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.end_datetime | date('dd/MM/yyyy HH:mm') }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>المدة</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ "%.1f"|format(object.allocated_hours) }} ساعة</td>
        </tr>
    </table>
    {% if object.note %}
    <p><strong>ملاحظة:</strong> {{ object.note }}</p>
    {% endif %}
    <p style="color: #888; font-size: 12px;">هذا إشعار تلقائي من نظام التخطيط</p>
</div>
            ]]></field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- إشعار طلب تبادل الشيفت -->
        <record id="email_template_shift_switch" model="mail.template">
            <field name="name">Planning: طلب تبادل الشيفت</field>
            <field name="model_id" ref="model_planning_shift"/>
            <field name="subject">🔁 طلب تبادل شيفت: {{ object.start_datetime | date('dd/MM/yyyy') }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; direction: rtl; padding: 20px;">
    <h2 style="color: #e67e22;">🔁 طلب تبادل شيفت</h2>
    <p>{{ object.switch_requested_by.name }} يطلب تبادل شيفته:</p>
    <p>📅 {{ object.start_datetime | date('dd/MM/yyyy HH:mm') }} — {{ object.end_datetime | date('HH:mm') }}</p>
    <p>الدور المطلوب: <strong>{{ object.role_id.name or 'أي دور' }}</strong></p>
    <p>سجّل دخولك للنظام لأخذ هذا الشيفت.</p>
</div>
            ]]></field>
        </record>

    </data>
</odoo>
