<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_planning_role_form" model="ir.ui.view">
        <field name="name">planning.role.form</field>
        <field name="model">planning.role</field>
        <field name="arch" type="xml">
            <form string="دور">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" icon="fa-calendar">
                            <field name="shift_count" widget="statinfo" string="شيفت"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="اسم الدور..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="resource_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_planning_role_tree" model="ir.ui.view">
        <field name="name">planning.role.tree</field>
        <field name="model">planning.role</field>
        <field name="arch" type="xml">
            <tree string="الأدوار" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="shift_count" string="عدد الشيفتات"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_planning_roles" model="ir.actions.act_window">
        <field name="name">الأدوار</field>
        <field name="res_model">planning.role</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
