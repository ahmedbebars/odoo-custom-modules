<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- تمديد ملف الموظف -->
    <record id="view_hr_employee_planning" model="ir.ui.view">
        <field name="name">hr.employee.planning.tab</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="📅 التخطيط" name="planning_tab">
                    <group>
                        <group string="أدوار التخطيط">
                            <field name="planning_role_ids" widget="many2many_tags"/>
                            <field name="planning_default_role_id"
                                   domain="[('id', 'in', planning_role_ids)]"/>
                        </group>
                        <group string="إحصائيات الشهر الحالي">
                            <field name="planned_shifts_count" readonly="1"/>
                            <field name="planned_hours_month" widget="float_time" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Advanced Report Action -->
    <record id="action_planning_report" model="ir.actions.act_window">
        <field name="name">📊 تقارير التخطيط</field>
        <field name="res_model">planning.shift</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="domain">[('state', 'in', ['published', 'done'])]</field>
    </record>
</odoo>
