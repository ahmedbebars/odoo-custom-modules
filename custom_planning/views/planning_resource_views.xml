<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_planning_resource_form" model="ir.ui.view">
        <field name="name">planning.resource.form</field>
        <field name="model">planning.resource</field>
        <field name="arch" type="xml">
            <form string="مورد">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" icon="fa-calendar">
                            <field name="shift_count" widget="statinfo" string="شيفت"/>
                        </button>
                        <button class="oe_stat_button" type="object" icon="fa-clock-o">
                            <field name="planned_hours" widget="float_time" string="ساعات"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="اسم المورد..."/></h1>
                    </div>
                    <group>
                        <group string="معلومات أساسية">
                            <field name="resource_type"/>
                            <field name="employee_id"
                                   invisible="resource_type != 'employee'"/>
                            <field name="active"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group string="الأدوار">
                            <field name="role_ids" widget="many2many_tags"/>
                            <field name="default_role_id"
                                   domain="[('id', 'in', role_ids)]"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_planning_resource_tree" model="ir.ui.view">
        <field name="name">planning.resource.tree</field>
        <field name="model">planning.resource</field>
        <field name="arch" type="xml">
            <tree string="الموارد">
                <field name="name"/>
                <field name="resource_type" widget="badge"/>
                <field name="role_ids" widget="many2many_tags"/>
                <field name="default_role_id"/>
                <field name="shift_count" string="شيفتات الشهر"/>
                <field name="planned_hours" widget="float_time" string="ساعات الشهر"/>
            </tree>
        </field>
    </record>

    <record id="action_planning_resources" model="ir.actions.act_window">
        <field name="name">الموارد</field>
        <field name="res_model">planning.resource</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
