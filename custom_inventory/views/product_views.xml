<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_inventory_product_form" model="ir.ui.view">
        <field name="name">inventory.product.form</field>
        <field name="model">inventory.product</field>
        <field name="arch" type="xml">
            <form string="منتج المخزون">
                <header>
                    <button name="action_add_stock" string="➕ إضافة مخزون"
                            type="object" class="oe_highlight"/>
                    <button name="action_remove_stock" string="➖ صرف مخزون"
                            type="object"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_movements" type="object"
                                class="oe_stat_button" icon="fa-exchange">
                            <field name="movement_count" widget="statinfo"
                                   string="حركات"/>
                        </button>
                    </div>
                    <field name="image" widget="image"
                           class="oe_avatar" options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="اسم المنتج..." required="1"/>
                        </h1>
                        <div>
                            <field name="code" placeholder="كود المنتج..."/>
                        </div>
                    </div>

                    <!-- KPI Boxes -->
                    <div class="row mt16 mb16">
                        <div class="col-4 text-center">
                            <div style="background:#28a745;color:white;padding:15px;border-radius:8px;">
                                <div style="font-size:24px;font-weight:bold;">
                                    <field name="qty_on_hand" readonly="1"/>
                                </div>
                                <div>الكمية الفعلية</div>
                            </div>
                        </div>
                        <div class="col-4 text-center">
                            <div style="background:#17a2b8;color:white;padding:15px;border-radius:8px;">
                                <div style="font-size:24px;font-weight:bold;">
                                    <field name="qty_available" readonly="1"/>
                                </div>
                                <div>الكمية المتاحة</div>
                            </div>
                        </div>
                        <div class="col-4 text-center">
                            <div style="background:#ffc107;color:white;padding:15px;border-radius:8px;">
                                <div style="font-size:24px;font-weight:bold;">
                                    <field name="qty_reserved" readonly="1"/>
                                </div>
                                <div>محجوز</div>
                            </div>
                        </div>
                    </div>

                    <!-- تنبيه نقص المخزون -->
                    <div class="alert alert-warning" role="alert"
                         invisible="not low_stock_alert">
                        ⚠️ تحذير: الكمية الفعلية وصلت للحد الأدنى المحدد!
                    </div>

                    <notebook>
                        <page string="معلومات المنتج" name="info">
                            <group>
                                <group string="التصنيف">
                                    <field name="category"/>
                                    <field name="unit"/>
                                    <field name="location"/>
                                    <field name="supplier"/>
                                </group>
                                <group string="التسعير">
                                    <field name="cost_price"/>
                                    <field name="sale_price"/>
                                </group>
                            </group>
                            <group string="الوصف">
                                <field name="description" nolabel="1"/>
                            </group>
                        </page>

                        <page string="إعدادات المخزون" name="stock_settings">
                            <group>
                                <group>
                                    <field name="min_qty"/>
                                    <field name="max_qty"/>
                                    <field name="reorder_qty"/>
                                </group>
                            </group>
                        </page>

                        <page string="حركات المخزون" name="movements">
                            <field name="movement_ids" readonly="1">
                                <tree decoration-success="move_type == 'in' and state == 'done'"
                                      decoration-danger="move_type == 'out' and state == 'done'"
                                      decoration-muted="state == 'cancelled'">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="move_type"/>
                                    <field name="quantity"/>
                                    <field name="total_value"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_inventory_product_tree" model="ir.ui.view">
        <field name="name">inventory.product.tree</field>
        <field name="model">inventory.product</field>
        <field name="arch" type="xml">
            <tree string="المنتجات"
                  decoration-danger="low_stock_alert == True"
                  decoration-muted="active == False">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="unit"/>
                <field name="qty_on_hand" string="الكمية الفعلية"/>
                <field name="qty_available" string="المتاح"/>
                <field name="qty_reserved" string="محجوز"/>
                <field name="min_qty" string="الحد الأدنى"/>
                <field name="cost_price" string="سعر التكلفة"/>
                <field name="low_stock_alert" string="⚠️" widget="boolean"/>
                <field name="active" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_inventory_product_kanban" model="ir.ui.view">
        <field name="name">inventory.product.kanban</field>
        <field name="model">inventory.product</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="category">
                <field name="name"/>
                <field name="code"/>
                <field name="qty_on_hand"/>
                <field name="qty_available"/>
                <field name="low_stock_alert"/>
                <field name="category"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    كود: <field name="code"/>
                                </div>
                                <div>
                                    كمية فعلية: <b><field name="qty_on_hand"/></b>
                                    | متاح: <b><field name="qty_available"/></b>
                                </div>
                                <div t-if="record.low_stock_alert.raw_value"
                                     class="badge badge-warning mt4">
                                    ⚠️ مخزون منخفض
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_inventory_product_search" model="ir.ui.view">
        <field name="name">inventory.product.search</field>
        <field name="model">inventory.product</field>
        <field name="arch" type="xml">
            <search string="بحث في المنتجات">
                <field name="name" string="اسم المنتج"/>
                <field name="code" string="الكود"/>
                <field name="supplier" string="المورد"/>
                <separator/>
                <filter name="low_stock" string="⚠️ مخزون منخفض"
                        domain="[('low_stock_alert','=',True)]"/>
                <filter name="in_stock" string="متاح في المخزون"
                        domain="[('qty_available','&gt;',0)]"/>
                <filter name="out_stock" string="نفد من المخزون"
                        domain="[('qty_available','&lt;=',0)]"/>
                <separator/>
                <filter name="active" string="نشط" domain="[('active','=',True)]"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="group_category" string="الفئة"
                            context="{'group_by': 'category'}"/>
                    <filter name="group_unit" string="الوحدة"
                            context="{'group_by': 'unit'}"/>
                    <filter name="group_location" string="المكان"
                            context="{'group_by': 'location'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_inventory_product" model="ir.actions.act_window">
        <field name="name">المنتجات</field>
        <field name="res_model">inventory.product</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_inventory_product_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">أضف أول منتج للمخزون!</p>
            <p>تتبع كميات المنتجات وحركات المخزون بسهولة.</p>
        </field>
    </record>

    <!-- Low Stock Action -->
    <record id="action_low_stock_products" model="ir.actions.act_window">
        <field name="name">⚠️ منتجات مخزونها منخفض</field>
        <field name="res_model">inventory.product</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('low_stock_alert','=',True)]</field>
    </record>

</odoo>
