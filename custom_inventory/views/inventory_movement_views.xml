<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inventory_movement_form" model="ir.ui.view">
        <field name="name">inventory.movement.form</field>
        <field name="model">inventory.movement</field>
        <field name="arch" type="xml">
            <form string="حركة مخزون">
                <header>
                    <button name="action_confirm" string="تنفيذ" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="إلغاء" type="object" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group><field name="name"/><field name="movement_type"/><field name="date"/></group>
                        <group><field name="product_id"/><field name="quantity"/><field name="unit_cost"/><field name="total_cost" readonly="1"/></group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="view_inventory_movement_tree" model="ir.ui.view">
        <field name="name">inventory.movement.tree</field>
        <field name="model">inventory.movement</field>
        <field name="arch" type="xml">
            <tree string="حركات المخزون" decoration-success="movement_type=='in'" decoration-danger="movement_type=='out'">
                <field name="name"/><field name="product_id"/><field name="movement_type"/>
                <field name="quantity"/><field name="total_cost"/><field name="date"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>
    <record id="action_inventory_movements" model="ir.actions.act_window">
        <field name="name">حركات المخزون</field>
        <field name="res_model">inventory.movement</field>
        <field name="view_mode">tree,form,pivot,graph</field>
    </record>
</odoo>
