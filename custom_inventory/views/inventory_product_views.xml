<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inventory_product_form" model="ir.ui.view">
        <field name="name">inventory.product.form</field>
        <field name="model">inventory.product</field>
        <field name="arch" type="xml">
            <form string="منتج المخزون">
                <sheet>
                    <div class="alert alert-warning" invisible="not low_stock_alert">
                        ⚠️ تنبيه: الكمية الحالية أقل من الحد الأدنى!
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/><field name="category"/>
                            <field name="unit"/><field name="active"/>
                        </group>
                        <group string="الأسعار">
                            <field name="cost_price"/><field name="sale_price"/>
                        </group>
                    </group>
                    <group string="المخزون">
                        <group>
                            <field name="current_qty" readonly="1"/>
                            <field name="reserved_qty"/>
                            <field name="available_qty" readonly="1"/>
                        </group>
                        <group>
                            <field name="min_qty"/><field name="max_qty"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="الحركات">
                            <field name="movement_ids" readonly="1">
                                <tree>
                                    <field name="name"/><field name="movement_type"/>
                                    <field name="quantity"/><field name="date"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="view_inventory_product_tree" model="ir.ui.view">
        <field name="name">inventory.product.tree</field>
        <field name="model">inventory.product</field>
        <field name="arch" type="xml">
            <tree string="المنتجات" decoration-danger="low_stock_alert">
                <field name="code"/><field name="name"/><field name="category"/>
                <field name="current_qty"/><field name="available_qty"/>
                <field name="min_qty"/><field name="low_stock_alert" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <record id="action_inventory_products" model="ir.actions.act_window">
        <field name="name">المنتجات</field>
        <field name="res_model">inventory.product</field>
        <field name="view_mode">tree,form,pivot</field>
    </record>
</odoo>
