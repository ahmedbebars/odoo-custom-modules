<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_ext_form" model="ir.ui.view">
        <field name="name">pos.order.extension.form</field>
        <field name="model">pos.order.extension</field>
        <field name="arch" type="xml">
            <form string="أمر POS">
                <header>
                    <button name="action_send_to_kitchen" string="🍳 إرسال للمطبخ" type="object" class="oe_highlight" invisible="kitchen_status != 'pending'"/>
                    <button name="action_mark_ready" string="✅ جاهز للتقديم" type="object" invisible="kitchen_status != 'preparing'"/>
                    <button name="action_split_bill" string="✂️ Split Bill" type="object" invisible="state != 'open'"/>
                    <button name="action_pay" string="💳 دفع" type="object" class="oe_highlight" invisible="state not in ['open','split']"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/><field name="order_type"/>
                            <field name="table_number"/><field name="customer_count"/>
                            <field name="kitchen_status" widget="badge"/>
                        </group>
                        <group>
                            <field name="customer_name"/>
                            <field name="payment_method"/>
                            <field name="split_count" invisible="state != 'split'"/>
                            <field name="split_amount" readonly="1" invisible="state != 'split'"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="product_name"/><field name="quantity"/>
                            <field name="unit_price"/><field name="subtotal" readonly="1"/>
                            <field name="notes"/>
                        </tree>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="subtotal"/><field name="discount_amount"/>
                        <field name="tax_amount" readonly="1"/>
                        <field name="total_amount" readonly="1" class="oe_subtotal_footer_separator"/>
                    </group>
                    <field name="notes" placeholder="ملاحظات للمطبخ..."/>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="view_pos_order_ext_tree" model="ir.ui.view">
        <field name="name">pos.order.extension.tree</field>
        <field name="model">pos.order.extension</field>
        <field name="arch" type="xml">
            <tree string="طلبات POS" decoration-success="state=='paid'" decoration-warning="kitchen_status=='ready'">
                <field name="name"/><field name="order_type"/><field name="table_number"/>
                <field name="customer_name"/><field name="total_amount"/>
                <field name="kitchen_status" widget="badge" decoration-warning="kitchen_status=='ready'" decoration-info="kitchen_status=='preparing'"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>
    <record id="action_pos_order_extensions" model="ir.actions.act_window">
        <field name="name">طلبات POS</field>
        <field name="res_model">pos.order.extension</field>
        <field name="view_mode">tree,form,kanban</field>
    </record>
    <record id="action_pos_loyalty_cards" model="ir.actions.act_window">
        <field name="name">بطاقات الولاء</field>
        <field name="res_model">pos.loyalty.card</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_pos_floor_plan" model="ir.actions.act_window">
        <field name="name">مخطط الطابق</field>
        <field name="res_model">pos.floor.plan</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
